            "{{productId}}"
          ]
        },
        "description": "Повне оновлення тестового товару",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тест 2\",\n  \"price\": 120,\n  \"stock\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
