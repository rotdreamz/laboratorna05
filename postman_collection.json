{
  "info": {
    "name": "Shop API",
    "description": "Тестова колекція REST API магазину (Лабораторна робота 05)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET список товарів",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Успішний запит: список усіх товарів"
      }
    },
    {
      "name": "02 GET один товар",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "1"
          ]
        },
        "description": "Успішний запит: товар з id=1 (змініть id, якщо такого товару немає)"
      }
    },
    {
      "name": "03 GET неіснуючий товар",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "9999"
          ]
        },
        "description": "Помилка: товару не існує"
      }
    },
    {
      "name": "04 POST створити товар",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"У відповіді є id\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.collectionVariables.set(\"productId\", json.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Створює тестовий товар і зберігає його id у змінну productId",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Тестовий товар\",\n  \"price\": 99.5,\n  \"stock\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 POST без назви",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 400\", function () {",
